{
  "manifest_version": 2,
  "name": "SOCKS5 Proxy Switcher",
  "version": "1.0",
  "description": "Автоматический выбор лучшего SOCKS5 прокси",
  "permissions": [
    "proxy",
    "storage",
    "https://raw.githubusercontent.com/*",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "proxy-switcher@example.com",
      "strict_min_version": "91.1.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "technicalAndInteraction"
        ]
      }
    }
  }
}